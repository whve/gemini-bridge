# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/

# Distribution / packaging
build/
dist/
*.egg-info/

# Local runtime data & logs (never commit user tasks or session data)
data/*.db
data/tasks.db
data/tasks.db-journal
data/tasks.db-wal
data/tasks.db-shm
data/logs/*.log
*.log
autopi.log
results/deep-research/*
results/app-tasks/*
!results/deep-research/.gitkeep
!results/app-tasks/.gitkeep
downloads/*
!downloads/.gitkeep
downloads_test/*
!downloads_test/.gitkeep

# Local configuration, caches & OS files
config.yaml
.env
chrome-profile/
.pytest_cache/
.trash/
.DS_Store
